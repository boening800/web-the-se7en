---
import Base from '../layouts/Base.astro';
import Sparkle from '../components/Sparkle.astro';
---

<Base title="Página no encontrada | The Se7en">
  <main class="not-found">
    <Sparkle class="nf-sparkle" />
    <h1>Esta página no existe</h1>
    <p>Pero tu case perfecto sí. Vuelve al inicio y hazlo tuyo.</p>
    <a class="btn" href="/">Volver al inicio</a>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    min-height: 100svh;
    padding: var(--gutter);
    text-align: center;
  }

  .not-found :global(.nf-sparkle) {
    width: 4rem;
  }

  h1 {
    margin: 0;
    color: var(--color-rosa);
    font-family: var(--font-titulo);
    font-size: clamp(2.2rem, 6vw, 3.5rem);
  }

  p {
    margin: 0;
    color: var(--color-rosa-intenso);
  }
</style>
