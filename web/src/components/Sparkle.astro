---
// Destello de la marca usado como decoración.
import { Image } from 'astro:assets';
import destello from '../assets/images/destello.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Image class:list={['sparkle', className]} src={destello} alt="" widths={[96, 209]} sizes="6rem" />

<style>
  .sparkle {
    display: block;
    height: auto;
    pointer-events: none;
    animation: twinkle 4s ease-in-out infinite;
  }
</style>
