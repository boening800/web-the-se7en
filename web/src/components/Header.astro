---
import { NAV } from '../config/site';
---

<header class="header">
  <nav aria-label="Principal">
    <ul>
      {
        NAV.map((item, i) => (
          <li>
            <a href={item.href} aria-current={i === 0 ? 'true' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Marca en el menú la sección visible.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.header a')];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((el): el is HTMLElement => el !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => observer.observe(section));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-blanco) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  ul {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 9vw, 6.5rem);
    margin: 0;
    padding: 1.1rem var(--gutter);
    list-style: none;
  }

  a {
    position: relative;
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--color-rosa);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  a::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.1rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  a:hover::after {
    transform: scaleX(1);
  }

  a[aria-current='true'] {
    color: var(--color-vino);
    font-weight: 700;
  }
</style>
