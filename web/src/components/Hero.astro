---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-the-se7en.png';
import heroCase from '../assets/images/hero-case.webp';
import Sparkle from './Sparkle.astro';
import Floaters, { type Floater } from './Floaters.astro';
import { whatsappUrl } from '../config/site';

const caseFloaters: Floater[] = [
  { kind: 'sparkle', top: '6%', left: '88%', size: 2.6, depth: 0.12, duration: 6 },
  { kind: 'pearl', color: 'azul', top: '18%', left: '-6%', size: 1.1, depth: 0.2, duration: 7, delay: -2 },
  { kind: 'pearl', color: 'dorado', top: '62%', left: '-12%', size: 0.8, depth: 0.28, duration: 8, delay: -4 },
  { kind: 'pearl', color: 'fucsia', top: '88%', left: '70%', size: 1.4, depth: 0.1, duration: 6.5, front: true },
  { kind: 'pearl', color: 'verde', top: '40%', left: '96%', size: 0.7, depth: 0.25, duration: 9, delay: -3 },
];

const copyFloaters: Floater[] = [
  { kind: 'pearl', color: 'morado', top: '-8%', left: '72%', size: 0.9, depth: 0.22, duration: 8, delay: -1 },
  { kind: 'pearl', color: 'rosa', top: '92%', left: '12%', size: 1.2, depth: 0.16, duration: 7.5, delay: -5 },
];
---

<section id="inicio" class="hero">
  <div class="circle circle--right" data-parallax="0.18" aria-hidden="true"></div>

  <h1 class="logo">
    <Image
      src={logo}
      alt="The Se7en"
      widths={[480, 860, 1675]}
      sizes="(min-width: 60rem) 53rem, 90vw"
      loading="eager"
      fetchpriority="high"
    />
  </h1>

  <div class="content">
    <div class="visual" data-reveal>
      <div class="circle circle--fill" data-parallax="0.12" aria-hidden="true"></div>
      <div class="circle circle--line" data-parallax="0.22" aria-hidden="true"></div>
      <Floaters items={caseFloaters} />
      <Image
        class="case"
        src={heroCase}
        alt="Case transparente personalizado con stickers de estrellas y perlas de colores"
        widths={[360, 560, 840]}
        sizes="(min-width: 48rem) 26rem, 80vw"
        loading="eager"
      />
    </div>

    <div class="copy" data-reveal>
      <p class="tagline">
        <span class="tagline__first">Tu mundo,</span>
        <span class="tagline__second">a tu manera</span>
      </p>
      <Floaters items={copyFloaters} />
      <Sparkle class="sparkle-tagline" />
      <a class="btn btn--shine" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
        Hazlo tuyo<span class="visually-hidden"> (abre WhatsApp)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
    /* Los círculos salen por los lados sin cortarse por abajo. */
    overflow-x: clip;
  }

  .circle {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .circle--right {
    top: clamp(18rem, 40vw, 24rem);
    right: -14rem;
    width: 20rem;
    background: var(--color-rosa-suave);
  }

  .logo {
    width: min(100% - 2 * var(--gutter), 53rem);
    margin: 0 auto;
  }

  .content {
    position: relative;
    display: grid;
    align-items: center;
    max-width: var(--ancho-max);
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
  }

  /* Círculos detrás del celular: siguen al celular y salen por la izquierda en pantallas medianas. */
  .circle--fill {
    top: 12%;
    right: 50%;
    width: 110%;
    background: var(--color-rosa-claro);
  }

  .circle--line {
    top: -2%;
    right: 66%;
    width: 100%;
    border: 1px solid var(--color-vino);
  }

  .visual {
    position: relative;
    width: min(80vw, 26rem);
    margin-inline: auto;
    padding-block: 2rem;
  }

  .visual :global(.case) {
    position: relative;
    z-index: 1;
    width: 100%;
    animation: float 6s ease-in-out infinite alternate;
    filter: drop-shadow(0 1.25rem 1.5rem color-mix(in srgb, var(--color-vino) 18%, transparent));
  }

  .copy {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: 2rem var(--gutter) 3rem;
  }

  .tagline {
    margin: 0;
    font-family: var(--font-titulo);
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1.05;
  }

  .tagline span {
    display: block;
  }

  .tagline__first {
    color: var(--color-vino);
    font-weight: 500;
  }

  .tagline__second {
    padding-left: 0.5em;
    color: var(--color-rosa-intenso);
    font-style: italic;
    font-weight: 700;
  }

  .copy :global(.sparkle-tagline) {
    position: absolute;
    right: max(var(--gutter), 8%);
    width: clamp(3rem, 8vw, 5.25rem);
  }

  @media (min-width: 48rem) {
    .content {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }

    .visual {
      justify-self: end;
      width: min(100% - var(--gutter), 26rem);
      margin: 0 clamp(0rem, 2vw, 2rem) 0 0;
    }

    .copy {
      max-width: 44rem;
      justify-items: start;
      padding-block: 0 4rem;
    }

    .btn {
      margin-left: 18%;
    }

    .copy :global(.sparkle-tagline) {
      bottom: 22%;
      right: var(--gutter);
    }
  }

  @media (max-width: 47.99rem) {
    .copy :global(.sparkle-tagline) {
      top: 0;
    }
  }
</style>
