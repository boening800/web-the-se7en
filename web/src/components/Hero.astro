---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-the-se7en.png';
import heroCase from '../assets/images/hero-case.webp';
import Sparkle from './Sparkle.astro';
import { whatsappUrl } from '../config/site';
---

<section id="inicio" class="hero">
  <div class="circle circle--right" aria-hidden="true"></div>

  <h1 class="logo">
    <Image
      src={logo}
      alt="The Se7en"
      widths={[480, 860, 1675]}
      sizes="(min-width: 60rem) 53rem, 90vw"
      loading="eager"
      fetchpriority="high"
    />
  </h1>

  <div class="content">
    <div class="circle circle--fill" aria-hidden="true"></div>
    <div class="circle circle--line" aria-hidden="true"></div>
    <div class="visual" data-reveal>
      <Image
        class="case"
        src={heroCase}
        alt="Case transparente personalizado con stickers de estrellas y perlas de colores"
        widths={[360, 560, 840]}
        sizes="(min-width: 48rem) 26rem, 80vw"
        loading="eager"
      />
    </div>

    <div class="copy" data-reveal>
      <p class="tagline">
        <span class="tagline__first">Tu mundo,</span>
        <span class="tagline__second">a tu manera</span>
      </p>
      <Sparkle class="sparkle-tagline" />
      <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
        Hazlo tuyo<span class="visually-hidden"> (abre WhatsApp)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
    /* Los círculos salen por los lados sin cortarse por abajo. */
    overflow-x: clip;
  }

  .circle {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .circle--right {
    top: clamp(18rem, 40vw, 24rem);
    right: -14rem;
    width: 20rem;
    background: var(--color-rosa-suave);
  }

  .logo {
    width: min(100% - 2 * var(--gutter), 53rem);
    margin: 0 auto;
  }

  .content {
    position: relative;
    display: grid;
    align-items: center;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* Círculos detrás del celular: anclados al borde izquierdo de la pantalla. */
  .circle--fill {
    top: 32%;
    left: 0;
    width: clamp(22rem, 38vw, 40rem);
    background: var(--color-rosa-claro);
    transform: translate(-40%, -40%);
  }

  .circle--line {
    top: 27%;
    left: 0;
    width: clamp(20rem, 34vw, 36rem);
    border: 1px solid var(--color-vino);
    transform: translate(-58%, -58%);
  }

  .visual {
    position: relative;
    width: min(80vw, 26rem);
    margin-inline: auto;
    padding-block: 2rem;
  }

  .visual :global(.case) {
    position: relative;
    width: 100%;
    filter: drop-shadow(0 1.25rem 1.5rem color-mix(in srgb, var(--color-vino) 18%, transparent));
  }

  .copy {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: 2rem var(--gutter) 3rem;
  }

  .tagline {
    margin: 0;
    font-family: var(--font-titulo);
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1.05;
  }

  .tagline span {
    display: block;
  }

  .tagline__first {
    color: var(--color-vino);
    font-weight: 500;
  }

  .tagline__second {
    padding-left: 0.5em;
    color: var(--color-rosa-intenso);
    font-style: italic;
    font-weight: 700;
  }

  .copy :global(.sparkle-tagline) {
    position: absolute;
    right: max(var(--gutter), 8%);
    width: clamp(3rem, 8vw, 5.25rem);
  }

  @media (min-width: 48rem) {
    .content {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }

    .circle--fill {
      top: 55%;
    }

    .circle--line {
      top: 50%;
    }

    .visual {
      width: min(100% - clamp(1rem, 10vw, 12rem), 26rem);
      margin-left: clamp(1rem, 10vw, 12rem);
    }

    .copy {
      max-width: 44rem;
      justify-items: start;
      padding-block: 0 4rem;
    }

    .btn {
      margin-left: 18%;
    }

    .copy :global(.sparkle-tagline) {
      bottom: 22%;
      right: var(--gutter);
    }
  }

  @media (max-width: 47.99rem) {
    .copy :global(.sparkle-tagline) {
      top: 0;
    }
  }
</style>
