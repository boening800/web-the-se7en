---
// Destellos decorativos que flotan despacio. Se posicionan dentro del
// contenedor padre (que debe tener position: relative).
import { Image } from 'astro:assets';
import destello from '../assets/images/destello.png';

export type Floater = {
  top: string;
  left: string;
  /** Tamaño en rem. */
  size: number;
  /** Velocidad de parallax: más alto = se queda más atrás al hacer scroll. */
  depth?: number;
  /** Duración del ciclo de flotación en segundos. */
  duration?: number;
  delay?: number;
};

interface Props {
  items: Floater[];
}

const { items } = Astro.props;
---

{
  items.map((item) => (
    <span
      class="floater"
      style={`--top:${item.top};--left:${item.left};--size:${item.size}rem;--dur:${item.duration ?? 7}s;--delay:${item.delay ?? 0}s`}
      data-parallax={item.depth ?? 0.08}
      aria-hidden="true"
    >
      <Image class="floater__sparkle" src={destello} alt="" widths={[64, 128]} sizes="4rem" />
    </span>
  ))
}

<style>
  .floater {
    position: absolute;
    top: var(--top);
    left: var(--left);
    z-index: 0;
    width: var(--size);
    pointer-events: none;
  }

  .floater__sparkle {
    display: block;
    width: 100%;
    height: auto;
    animation:
      float var(--dur) ease-in-out var(--delay) infinite alternate,
      twinkle 3.5s ease-in-out var(--delay) infinite;
  }
</style>
